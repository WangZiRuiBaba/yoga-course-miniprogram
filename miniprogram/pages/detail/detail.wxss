.cover-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  background: #eeebff;
}

.cover {
  width: 100%;
  height: 100%;
}

.cover-badge {
  position: absolute;
  left: 24rpx;
  bottom: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(31, 31, 44, 0.55);
  color: #ffffff;
  font-size: 22rpx;
}

.detail-head {
  margin-top: -24rpx;
}

.d-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f1f2c;
  line-height: 1.4;
}

.d-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #75758f;
  line-height: 1.5;
}

.info-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5fa;
}

.info-label {
  width: 160rpx;
  flex: none;
  font-size: 26rpx;
  color: #8a8aa3;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1f1f2c;
  line-height: 1.5;
}

.sku-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.sku {
  min-width: 200rpx;
  padding: 16rpx 22rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e8e8f2;
  background: #fafaff;
  display: flex;
  flex-direction: column;
}

.sku-active {
  border-color: #6c5ce7;
  background: #eeebff;
}

.sku-off {
  opacity: 0.45;
}

.sku-name {
  font-size: 26rpx;
  color: #1f1f2c;
}

.sku-price {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6c5ce7;
  font-weight: 600;
}

.qty-row {
  margin-top: 26rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 10rpx;
  background: #f2f2f8;
  color: #1f1f2c;
  font-size: 30rpx;
}

.stepper-off {
  color: #c8c8d8;
}

.stepper-num {
  min-width: 70rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1f1f2c;
}

.rich {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #44445a;
  line-height: 1.7;
}

.faq-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5fa;
}

.faq-q {
  font-size: 27rpx;
  color: #1f1f2c;
  line-height: 1.5;
}

.faq-arrow {
  margin-left: 16rpx;
  font-size: 30rpx;
  color: #8a8aa3;
}

.faq-a {
  display: block;
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #75758f;
  line-height: 1.6;
}

.related {
  margin: 8rpx 24rpx 30rpx;
}

.related .card-title {
  margin-bottom: 12rpx;
}

.bar-service {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
}

.bar-service-hover {
  opacity: 0.6;
}

.bar-service-icon {
  font-size: 30rpx;
}

.bar-service-text {
  font-size: 20rpx;
  color: #8a8aa3;
}

.bar-price {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding-left: 12rpx;
}

.bar-price-label {
  font-size: 22rpx;
  color: #8a8aa3;
  margin-right: 8rpx;
}

.bar-price-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #ff7a59;
}

.bar-buy {
  width: 240rpx;
  flex: none;
}
