.ds-hero {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #6c5ce7 0%, #8f7bff 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(108, 92, 231, 0.28);
}

.ds-hero-label {
  font-size: 24rpx;
  opacity: 0.82;
}

.ds-hero-unit {
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 8rpx;
}

.ds-hero-amount {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ds-hero-btn {
  padding: 0 32rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background: #ffffff;
  color: #6c5ce7;
  font-size: 26rpx;
  font-weight: 600;
}

.ds-hero-btn-off {
  opacity: 0.55;
}

.ds-hero-meta {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.28);
}

.ds-hero-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ds-hero-cell-v {
  font-size: 28rpx;
  font-weight: 600;
}

.ds-hero-cell-k {
  font-size: 21rpx;
  opacity: 0.78;
  margin-top: 4rpx;
}

.ds-hero-tip {
  display: block;
  margin-top: 18rpx;
  font-size: 20rpx;
  opacity: 0.72;
}

.ds-stat {
  display: flex;
  flex-direction: row;
  margin: 0 24rpx 24rpx;
}

.ds-stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ds-stat-v {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f2c;
}

.ds-stat-k {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8a8aa3;
}

.ds-invite,
.ds-lock,
.ds-bind {
  margin: 0 24rpx 24rpx;
}

.ds-level {
  font-size: 21rpx;
  color: #6c5ce7;
  background: #f2f0ff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.ds-code-row {
  margin-top: 18rpx;
  align-items: center;
}

.ds-code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #6c5ce7;
  flex: 1;
}

.ds-copy {
  font-size: 23rpx;
  color: #6c5ce7;
  border: 1rpx solid #d9d3ff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.ds-invite-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a8aa3;
  line-height: 1.6;
}

.ds-tips {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
}

.ds-tip-item {
  font-size: 21rpx;
  color: #8a8aa3;
  line-height: 1.75;
}

.ds-share {
  margin: 0;
  line-height: 60rpx;
  height: 60rpx;
  font-size: 24rpx;
}

.ds-lock-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f2c;
}

.ds-lock-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #8a8aa3;
  line-height: 1.7;
}

.ds-bind-row {
  margin-top: 16rpx;
  align-items: center;
}

.ds-bind-row .input {
  height: 72rpx;
  background: #f5f5fa;
  border-radius: 12rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.ds-bind-row .btn {
  margin-left: 16rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.ds-tabs {
  margin: 0 24rpx 16rpx;
}

.ds-sub {
  margin: 0 24rpx 16rpx;
  white-space: nowrap;
}

.ds-sub .chip {
  display: inline-block;
  margin-right: 14rpx;
}

.ds-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 0 24rpx 16rpx;
}

.ds-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eeebff;
  margin-right: 20rpx;
  flex: none;
}

.ds-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6c5ce7;
  font-size: 30rpx;
  font-weight: 600;
}

.ds-row-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f1f2c;
}

.ds-row-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8a8aa3;
}

.ds-row-right {
  align-items: flex-end;
  margin-left: 16rpx;
}

.ds-row-amount {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff7a59;
}

.ds-row-extra {
  margin-top: 6rpx;
  font-size: 19rpx;
  color: #b8b8c8;
}

.ds-withdraw-bar {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.ds-withdraw-info {
  display: flex;
  flex-direction: column;
}

.ds-withdraw-info .sub {
  font-size: 22rpx;
  color: #8a8aa3;
}

.ds-mini {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #f4f4fa;
}

.ds-mini-k {
  font-size: 23rpx;
  color: #5b5b72;
}

.ds-mini-v {
  font-size: 26rpx;
  font-weight: 600;
  color: #ff7a59;
}

.ds-foot {
  padding: 30rpx 0 50rpx;
  text-align: center;
}

.ds-foot-link {
  font-size: 23rpx;
  color: #6c5ce7;
}

.ds-foot-dot {
  margin: 0 12rpx;
  color: #c8c8d8;
  font-size: 20rpx;
}
