.search-bar {
  padding: 20rpx 24rpx 8rpx;
  background: #ffffff;
}

.search-input-wrap {
  height: 76rpx;
  border-radius: 38rpx;
  background: #f5f5fa;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1f1f2c;
}

.search-ph {
  color: #b8b8c8;
}

.search-clear {
  font-size: 24rpx;
  color: #b8b8c8;
  padding: 0 6rpx;
}

.filters {
  background: #ffffff;
  padding: 0 24rpx 16rpx;
  border-bottom: 1rpx solid #f2f2f8;
}

.filter-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
}

.filter-item {
  padding: 8rpx 22rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #55556b;
  background: #f5f5fa;
}

.filter-active {
  background: #eeebff;
  color: #6c5ce7;
  font-weight: 600;
}

.result-tip {
  padding: 20rpx 24rpx 4rpx;
  font-size: 22rpx;
  color: #a3a3b8;
}

.list {
  padding: 16rpx 24rpx 0;
}

.load-more {
  padding: 30rpx 0 50rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b8b8c8;
}
