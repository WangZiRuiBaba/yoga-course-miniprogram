.en-head {
  margin: 24rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #6c5ce7 0%, #8f7bff 100%);
  color: #ffffff;
  display: flex;
  flex-direction: column;
}

.en-head-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
}

.en-head-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.en-filters {
  margin: 0 24rpx 16rpx;
}

.en-empty-btn {
  display: flex;
  justify-content: center;
  margin-top: -20rpx;
  padding-bottom: 30rpx;
}

.en-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
}

.en-cover {
  width: 176rpx;
  height: 176rpx;
  border-radius: 14rpx;
  background: #eeebff;
  flex: none;
  margin-right: 20rpx;
}

.en-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.en-body {
  min-width: 0;
}

.en-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f1f2c;
  line-height: 1.4;
}

.en-tags {
  margin-top: 10rpx;
}

.en-tag-off {
  opacity: 0.55;
}

.en-expire {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #8a8aa3;
}

.en-foot {
  margin-top: 12rpx;
  align-items: center;
}

.en-code-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f7f7fb;
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
}

.en-code-label {
  font-size: 19rpx;
  color: #a3a3b8;
  margin-right: 8rpx;
}

.en-code {
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #6c5ce7;
}

.en-code-copy {
  margin-left: 10rpx;
  font-size: 19rpx;
  color: #ff7a59;
}

.en-more {
  font-size: 21rpx;
  color: #a3a3b8;
}

.en-foot-tip {
  padding: 10rpx 40rpx 50rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b8b8c8;
  line-height: 1.6;
}
