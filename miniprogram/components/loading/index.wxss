.ld {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 24rpx;
}

.ld-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #eeebff;
  border-top-color: #6c5ce7;
  animation: ld-rotate 0.8s linear infinite;
}

@keyframes ld-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.ld-text {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a8aa3;
}

.ld-skeleton {
  display: flex;
  flex-direction: row;
  width: 100%;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(108, 92, 231, 0.06);
}

.ld-block {
  width: 200rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2f2f8 25%, #fafaff 50%, #f2f2f8 75%);
  background-size: 400% 100%;
  animation: ld-shine 1.4s ease infinite;
}

.ld-lines {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
}

.ld-line {
  height: 22rpx;
  border-radius: 8rpx;
  width: 80%;
  background: linear-gradient(90deg, #f2f2f8 25%, #fafaff 50%, #f2f2f8 75%);
  background-size: 400% 100%;
  animation: ld-shine 1.4s ease infinite;
}

.ld-line-lg {
  height: 30rpx;
  width: 92%;
}

.ld-line-sm {
  width: 50%;
}

@keyframes ld-shine {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
