/* 全局样式：主色 #6C5CE7 紫 / 辅色 #FF7A59 橙 / 圆角 16rpx / 柔和阴影 */

page {
  --primary: #6c5ce7;
  --primary-soft: #eeebff;
  --accent: #ff7a59;
  --text: #1f1f2c;
  --sub: #8a8aa3;
  --line: #efeff6;
  --bg: #f7f7fb;
  --radius: 16rpx;
  --shadow: 0 6rpx 24rpx rgba(108, 92, 231, 0.08);

  background: #f7f7fb;
  color: #1f1f2c;
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
}

view,
text,
scroll-view,
input,
textarea,
button,
image,
navigator {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.page-with-bar {
  padding-bottom: 180rpx;
}

/* ---------- 布局 ---------- */
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.wrap {
  flex-wrap: wrap;
}

.gap-8 {
  gap: 8rpx;
}

.gap-16 {
  gap: 16rpx;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.p-24 { padding: 24rpx; }

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: var(--radius);
  box-shadow: 0 6rpx 24rpx rgba(108, 92, 231, 0.08);
  padding: 24rpx;
  margin: 20rpx 24rpx;
}

.card-flat {
  background: #ffffff;
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 20rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f2c;
}

.divider {
  height: 1rpx;
  background: #efeff6;
  margin: 20rpx 0;
}

/* ---------- 文本 ---------- */
.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f1f2c;
}

.sub {
  font-size: 24rpx;
  color: #8a8aa3;
}

.muted {
  color: #8a8aa3;
  font-size: 24rpx;
}

.strong {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ---------- 价格 ---------- */
.price {
  color: #ff7a59;
  font-weight: 700;
  font-size: 34rpx;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 2rpx;
}

.price-origin {
  color: #b8b8c8;
  font-size: 22rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.6;
  background: #eeebff;
  color: #6c5ce7;
  margin-right: 8rpx;
}

.tag-accent {
  background: #fff0ec;
  color: #ff7a59;
}

.tag-plain {
  background: #f4f4f8;
  color: #8a8aa3;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #7b6cf6 0%, #6c5ce7 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(108, 92, 231, 0.24);
}

.btn-accent {
  background: linear-gradient(135deg, #ff9a7a 0%, #ff7a59 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 89, 0.24);
}

.btn-ghost {
  background: #ffffff;
  color: #6c5ce7;
  border: 1rpx solid #ddd8ff;
}

.btn-plain {
  background: #f4f4f8;
  color: #55556b;
}

.btn-disabled {
  background: #e6e6ef;
  color: #a3a3b8;
  box-shadow: none;
}

.btn-sm {
  height: 60rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  padding: 0 26rpx;
}

.btn-block {
  width: 100%;
}

/* ---------- 底部固定操作栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(31, 31, 44, 0.06);
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 20;
}

/* ---------- 分段/筛选 ---------- */
.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  white-space: nowrap;
}

.chip {
  flex: none;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #55556b;
  font-size: 26rpx;
  border: 1rpx solid #eaeaf3;
}

.chip-active {
  background: #6c5ce7;
  color: #ffffff;
  border-color: #6c5ce7;
  box-shadow: 0 6rpx 16rpx rgba(108, 92, 231, 0.22);
}

/* ---------- 表单 ---------- */
.field {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #efeff6;
}

.field-label {
  width: 160rpx;
  color: #8a8aa3;
  font-size: 26rpx;
  flex: none;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f1f2c;
}

.input {
  height: 76rpx;
  background: #f7f7fb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

/* ---------- 气泡（AI / 客服） ---------- */
.bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble-left {
  background: #ffffff;
  color: #1f1f2c;
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 31, 44, 0.05);
}

.bubble-right {
  background: #6c5ce7;
  color: #ffffff;
  border-top-right-radius: 6rpx;
}

.notice {
  margin: 20rpx 24rpx 0;
  padding: 16rpx 22rpx;
  border-radius: 12rpx;
  background: #fff6ec;
  color: #b06400;
  font-size: 24rpx;
}
