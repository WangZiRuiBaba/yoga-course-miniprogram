# ===== 生产环境配置示例（复制为 .env 后修改，勿提交仓库）=====
# cp .env.production.example .env

# --- 运行环境 ---
NODE_ENV=production
PORT=3100
# 只监听本机，由 Nginx 对外提供 HTTPS（推荐）。若直接暴露公网改成 0.0.0.0
HOST=127.0.0.1
DB_PATH=./data/app.db

# --- 安全 ---
# 必须换掉：openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM_HEX
# 上线后必须为 false（生产环境默认已是 false，显式写上更安全）
ALLOW_DEV_LOGIN=false
# 后台初始账号：务必改成强密码，登录后由运营自行更改
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_STRONG_PASSWORD

# --- 微信登录（小程序后台 → 开发管理 → 开发设置）---
WX_APPID=wx0000000000000000
WX_SECRET=CHANGE_ME_APP_SECRET

# --- 微信支付（APIv3）---
PAY_PROVIDER=wxpay
MOCK_AUTO_PAY=0
WXPAY_MCHID=1900000000
WXPAY_SERIAL_NO=CHANGE_ME_CERT_SERIAL
WXPAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WXPAY_API_V3_KEY=CHANGE_ME_32_CHARS
# 支付回调必须 https 且公网可达，且在小程序后台不校验域名的场景下也不可用
WXPAY_NOTIFY_URL=https://your-domain.com/api/payment/wxpay/notify
WXPAY_PLATFORM_CERT_PATH=./certs/wechatpay_platform_cert.pem
WXPAY_PLATFORM_SERIAL_NO=CHANGE_ME_PLATFORM_SERIAL

# --- AI 商城 ---
# rule=离线规则引擎（零成本、可控）；llm=接大模型（需要 api key，异常自动降级 rule）
AI_PROVIDER=llm
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=CHANGE_ME
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000
