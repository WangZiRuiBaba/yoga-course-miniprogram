# ===== 复制为 .env 后按需修改；不填则使用下方默认值 =====

# --- 服务 ---
PORT=3100
HOST=127.0.0.1
# 生产置 1 会关闭 /api/auth/dev-login 与模拟支付
NODE_ENV=development
ALLOW_DEV_LOGIN=1

# --- 安全 ---
# 生产必须改成随机长串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-please-32bytes
USER_TOKEN_TTL_SECONDS=604800
ADMIN_TOKEN_TTL_SECONDS=43200

# --- 数据库 ---
DB_PATH=data/app.db

# --- 微信小程序 ---
# 不填则进入 mock 模式：wx.login 的 code 被哈希成稳定 openid，方便本地全流程调试
WX_APPID=
WX_SECRET=

# --- 支付 ---
# mock = 模拟支付（默认，可一键成功）；wxpay = 微信支付 APIv3
PAY_PROVIDER=mock
# 1 = 前端点击支付后自动成功（演示最顺）；0 = 需调用 /api/pay/mock/notify 才成功
MOCK_AUTO_PAY=1
MOCK_PAY_DELAY_MS=200

# 微信支付 APIv3（PAY_PROVIDER=wxpay 时必填）
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_PRIVATE_KEY_PATH=certs/apiclient_key.pem
WXPAY_APIV3_KEY=
WXPAY_NOTIFY_URL=https://your-domain.com/api/pay/notify/wxpay
WXPAY_PLATFORM_CERT_PATH=certs/wechatpay_platform_cert.pem
WXPAY_PLATFORM_SERIAL_NO=

# --- AI 商城 ---
# rule = 内置离线意图引擎（默认，无需 key）；llm = OpenAI 兼容接口（失败自动降级 rule）
AI_PROVIDER=rule
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=20000
AI_MAX_ROUNDS=4

# --- 后台初始账号（首次启动写入数据库，之后以数据库为准）---
ADMIN_USER=admin
ADMIN_PASS=admin123
